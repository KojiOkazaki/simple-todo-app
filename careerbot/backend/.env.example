# CareerBot backend configuration
# Copy to .env (loaded via `node --env-file=.env src/index.js`) or export in your shell.

# HTTP/WebSocket listen port
PORT=8080

# Device auth: comma-separated list of allowed device tokens (MVP simple scheme).
# Each device sends its token; empty value = accept any device (dev only).
DEVICE_TOKENS=cb-dev-token

# Voice provider: "mock" (offline, no API key) or "openai"
VOICE_PROVIDER=mock

# OpenAI Realtime API (only required when VOICE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_VOICE=alloy

# Audio defaults negotiated with the device
AUDIO_SAMPLE_RATE=16000

# Persistence: "memory" or "sqlite"
STORAGE=memory
SQLITE_PATH=./careerbot.db
