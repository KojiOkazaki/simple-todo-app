# CareerBot backend configuration
# Copy to .env (loaded via `node --env-file=.env src/index.js`) or export in your shell.

# HTTP/WebSocket listen port
PORT=8080

# Device auth: comma-separated list of allowed device tokens (MVP simple scheme).
# Each device sends its token; empty value = accept any device (dev only).
DEVICE_TOKENS=cb-dev-token

# Voice provider: "mock" (offline) | "openai" (Realtime) | "local" (Whisper+Gemma+VOICEVOX)
VOICE_PROVIDER=mock

# OpenAI Realtime API (only required when VOICE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_VOICE=alloy

# Local pipeline (only used when VOICE_PROVIDER=local). All run on your Mac.
# STT: OpenAI-compatible Whisper server (e.g. faster-whisper-server)
STT_URL=http://localhost:8000/v1/audio/transcriptions
STT_MODEL=whisper-1
# LLM: Gemma via Ollama's OpenAI-compatible endpoint (`ollama serve`)
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=gemma3
LLM_API_KEY=ollama
# TTS: VOICEVOX engine. ずんだもん(ノーマル)=3
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=3
# Voice output: "voicevox" (synthesize the AI text) or "soundboard" (play fixed
# local WAV clips from SOUNDBOARD_DIR; the AI answer is shown as text only).
# Keep clip files local — do not commit third-party voice assets.
VOICE_OUTPUT=voicevox
SOUNDBOARD_DIR=./clips
LOCAL_HISTORY_TURNS=12

# Audio defaults negotiated with the device
AUDIO_SAMPLE_RATE=16000

# Persistence: "memory" or "sqlite"
STORAGE=memory
SQLITE_PATH=./careerbot.db
